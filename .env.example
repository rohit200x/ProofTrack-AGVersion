# ProofTrack – development configuration. Copy to .env:  cp .env.example .env
# NEVER use these values in production (the backend refuses to start in production
# with default secrets or MinIO credentials).

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Docker Compose service credentials ---
POSTGRES_USER=prooftrack
POSTGRES_PASSWORD=prooftrack
POSTGRES_DB=prooftrack
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Host ports (change if they clash with something else on your machine) ---
WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8001
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011

# --- Database (used when running the backend/tests directly on the host;
#     docker compose overrides this to point at the "db" service) ---
DATABASE_URL=postgresql+psycopg://prooftrack:prooftrack@127.0.0.1:5433/prooftrack
TEST_DATABASE_URL=postgresql+psycopg://prooftrack:prooftrack@127.0.0.1:5433/prooftrack_test

# --- Security ---
# Generate for real deployments with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
SESSION_COOKIE_NAME=pt_session
SESSION_ABSOLUTE_HOURS=24
SESSION_IDLE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Extra allowed CORS origins (comma separated). Same-origin deployments need none.
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Object storage (S3 / MinIO). Bucket must be private. ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=prooftrack-proofs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ADDRESSING_STYLE=path
S3_CREATE_BUCKET=true

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_PROOF_PHOTOS=5
THUMBNAIL_MAX_PX=800

# --- Business defaults (admins can change timezone/retention in Settings) ---
BUSINESS_TIMEZONE=America/Chicago
PROOF_RETENTION_DAYS=365
ORGANIZATION_NAME=ProofTrack Logistics

# --- Development seed data (refused when ENVIRONMENT=production) ---
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@prooftrack.test
SEED_MANAGER_EMAIL=manager@prooftrack.test
SEED_DRIVER_EMAILS=driver1@prooftrack.test,driver2@prooftrack.test,driver3@prooftrack.test
SEED_PASSWORD=DemoPass2026!
